# Analytics and search (public; safe to expose in the browser)
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics loads only when set.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content attribute only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# MSG91 contact form delivery
# Run `npm run msg91:setup-contact-templates` once to provision or reuse the
# required template identifiers, then set the values below in Vercel.
# For the best shared-inbox threading behavior across Zoho Mail, Gmail, and
# Outlook, set both `MSG91_FROM_EMAIL` and `MSG91_REPLY_TO_EMAIL` to
# `help@vayasyaseva.com` if that address is verified in MSG91.
MSG91_AUTH_KEY=
MSG91_DOMAIN=
MSG91_FROM_EMAIL=
MSG91_FROM_NAME=
MSG91_REPLY_TO_EMAIL=help@vayasyaseva.com
# Canonical shared inbox. Phone-only submissions are delivered here, and
# acknowledgement emails are BCC'd here so replies stay visible in Zoho Mail.
CONTACT_INTERNAL_RECIPIENT_EMAIL=help@vayasyaseva.com
MSG91_INTERNAL_TEMPLATE_ID=
MSG91_AUTOREPLY_TEMPLATE_ID=
