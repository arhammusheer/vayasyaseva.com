# Analytics and search (public; safe to expose in the browser)
# Optional GA4 measurement ID override. Production defaults to G-80VCZT0V6G.
# Analytics loads after opt-in consent.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content attribute only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form emails (src/lib/contact-email.ts), sent as plain text through
# Resend from the verified notify.vayasyaseva.com domain. The key needs
# sending access to that domain.
RESEND_API_KEY=
# The shared inbox that gets every enquiry (default help@vayasyaseva.com).
CONTACT_INTERNAL_RECIPIENT_EMAIL=help@vayasyaseva.com
# Optional sender overrides (must be on a verified Resend domain).
# CONTACT_STAFF_EMAIL_FROM="Vayasya Seva website <website@notify.vayasyaseva.com>"
# CONTACT_BUYER_EMAIL_FROM="Vayasya Seva <enquiries@notify.vayasyaseva.com>"
