# Analytics and search (public; safe to expose in the browser)
# Optional GA4 measurement ID override. Production defaults to G-80VCZT0V6G.
# Analytics loads after opt-in consent.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content attribute only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form emails: none here. The site writes them (src/lib/contact-email.ts)
# and Windmill sends them through Resend with its own key, senders and inbox
# (integrations/windmill/leads/lib/lead-mail.ts).
