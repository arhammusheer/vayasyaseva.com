    {
      "id": "3f402d20-7877-560f-a7af-b39891650c0b",
      "name": "Files to fetch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "// Generated from integrations/n8n/src/nodes/files-to-fetch.ts by integrations/n8n/build.mts. Edit the source, not this.\n\nconst KIND = { audio: \"voice note\", image: \"photo\", document: \"document\" };\nasync function main() {\n    const conversationId = $(\"Chatwoot: create conversation\").first().json.id;\n    return $(\"Claim submission\")\n        .first()\n        .json.attachments.map((a, n) => ({\n        json: {\n            key: a.key,\n            conversationId,\n            label: `File ${n + 1}: ${KIND[a.kind] ?? \"file\"}${a.name ? ` (${a.name})` : \"\"}`,\n        },\n    }));\n}\n\nreturn main.call(this);"
      }
    },
