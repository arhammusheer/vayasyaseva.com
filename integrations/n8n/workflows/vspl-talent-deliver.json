    {
      "id": "de15167c-ff14-539c-a1b1-586e5cbbc646",
      "name": "Recover stuck",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE submissions\nSET status = CASE WHEN attempts >= 3 THEN 'failed' ELSE 'received' END,\n    last_error = coalesce(last_error, 'Timed out delivering to Chatwoot'),\n    updated_at = now()\nWHERE status = 'delivering' AND updated_at < now() - interval '15 minutes'\nRETURNING id;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2004d6af-1a6c-52e9-a169-9e91ef0487d2",
          "name": "talent-pg"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "07b6493e-4f28-5683-a2a7-39b3268c6e79",
      "name": "Claim submission",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\n  UPDATE submissions s\n  SET status = 'delivering', attempts = s.attempts + 1, updated_at = now()\n  WHERE s.id = (\n    SELECT c.id FROM submissions c\n    WHERE c.status = 'received'\n      AND NOT EXISTS (\n        SELECT 1 FROM attachments a\n        WHERE a.submission_id = c.id AND a.transcript_status IN ('pending', 'running'))\n    ORDER BY c.created_at LIMIT 1 FOR UPDATE SKIP LOCKED)\n  RETURNING s.id, s.ref, s.source, s.locale, s.phone, s.text\n)\nSELECT c.*, coalesce((\n  SELECT jsonb_agg(jsonb_build_object(\n    'id', a.id, 'position', a.position, 'kind', a.kind, 'key', a.r2_key, 'mime', a.mime,\n    'name', a.original_name, 'transcript', a.transcript, 'transcriptStatus', a.transcript_status\n  ) ORDER BY a.position)\n  FROM attachments a WHERE a.submission_id = c.id), '[]'::jsonb) AS attachments\nFROM claimed c;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2004d6af-1a6c-52e9-a169-9e91ef0487d2",
          "name": "talent-pg"
        }
      },
      "executeOnce": true
    },
    {
      "id": "04fe06b8-0dbc-5ee2-a822-fb8c7e900568",
      "name": "Claimed any?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        180
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "aa3666b3-c014-5d35-aabd-066b3bc3296e",
              "leftValue": "={{ $json.id !== undefined }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e7571d12-b768-5ccc-aa76-c49d02e62c55",
      "name": "Compose note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "// Generated from integrations/n8n/src/nodes/compose-note.ts by integrations/n8n/build.mts. Edit the source, not this.\n\nconst PAGES = {\n    web_en: \"English jobs page\",\n    web_hi: \"Hindi jobs page\",\n    web_hinglish: \"Hinglish jobs page\",\n};\nconst KIND = { audio: \"voice note\", image: \"photo\", document: \"document\" };\nasync function main() {\n    const s = $(\"Claim submission\").first().json;\n    const lines = [`**Job seeker ${s.ref}** · ${PAGES[s.source] ?? s.source} · ${s.phone}`];\n    if (s.text)\n        lines.push(\"\", \"**Their message:**\", s.text);\n    for (const [n, a] of s.attachments.entries()) {\n        if (a.kind !== \"audio\")\n            continue;\n        const transcript = a.transcriptStatus === \"done\" && a.transcript\n            ? a.transcript\n            : \"_Could not be transcribed. Listen to the attachment._\";\n        lines.push(\"\", `**Voice note (file ${n + 1}), automatic transcript:**`, transcript);\n    }\n    if (s.attachments.length) {\n        lines.push(\"\", `**Files (${s.attachments.length}):** ${s.attachments\n            .map((a, n) => `${n + 1}. ${KIND[a.kind] ?? \"file\"}${a.name ? ` (${a.name})` : \"\"}`)\n            .join(\" · \")}`);\n    }\n    return [{ json: { contactName: `Job seeker ${s.ref}`, note: lines.join(\"\\n\") } }];\n}\n\nreturn main.call(this);"
      }
    },
    {
      "id": "e522ae20-0c5f-57ad-a100-dfba7cc46683",
      "name": "Chatwoot: contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.chatwootBaseUrl }}/public/api/v1/inboxes/{{ $('Settings').first().json.chatwootInboxIdentifier }}/contacts",
        "authentication": "none",
        "sendHeaders": false,
        "sendBody": true,
        "options": {},
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_id: 'talent-' + $('Claim submission').first().json.phone.replace('+', ''), name: $json.contactName, phone_number: $('Claim submission').first().json.phone }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "e1fbe84b-ce5d-522f-a68e-68704fc0c56f",
