      "parameters": {
        "jsCode": "// Generated from integrations/n8n/src/nodes/erase-files.ts by integrations/n8n/build.mts. Edit the source, not this.\n\nasync function main() {\n    const claimed = $(\"Claim erasure\").first().json;\n    const keys = [...new Set(claimed.files.filter((key) => typeof key === \"string\" && key.length > 0))];\n    if (!keys.length)\n        return [{ json: { requestId: claimed.id, key: null } }];\n    return keys.map((key) => ({ json: { requestId: claimed.id, key } }));\n}\n\nreturn main.call(this);"
      }
