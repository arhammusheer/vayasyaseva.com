    {
      "id": "ae5d4a74-1530-56f5-aa90-0e03479bed59",
      "name": "Queue expired and recover",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH recovered AS (\n  UPDATE erasure_requests\n  SET status = CASE WHEN attempts >= 3 THEN 'failed' ELSE 'pending' END,\n      last_error = coalesce(last_error, 'Interrupted; retried'), updated_at = now()\n  WHERE status = 'running' AND updated_at < now() - interval '1 hour'\n  RETURNING id\n), expired AS (\n  SELECT p.phone FROM people p\n  WHERE greatest(coalesce(p.last_contact_at, p.created_at), coalesce(p.last_confirmed_at, p.created_at)) < now() - interval '12 months'\n  UNION\n  -- Submissions from before the people table, with no row of their own.\n  SELECT s.phone FROM submissions s\n  WHERE NOT EXISTS (SELECT 1 FROM people p WHERE p.phone = s.phone)\n  GROUP BY s.phone HAVING max(s.created_at) < now() - interval '12 months'\n), queued AS (\n  INSERT INTO erasure_requests (phone, reason)\n  SELECT phone, 'retention' FROM expired\n  ON CONFLICT (phone) WHERE status IN ('pending', 'running') DO NOTHING\n  RETURNING id\n)\nSELECT (SELECT count(*) FROM recovered) AS recovered, (SELECT count(*) FROM queued) AS queued;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2004d6af-1a6c-52e9-a169-9e91ef0487d2",
          "name": "talent-pg"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "84f1e38e-7f0b-5ee9-a6f9-23c7eb473c1e",
      "name": "Claim erasure",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claimed AS (\n  UPDATE erasure_requests e\n  SET status = 'running', attempts = e.attempts + 1, last_error = NULL, updated_at = now()\n  WHERE e.id = (\n    SELECT id FROM erasure_requests WHERE status = 'pending' AND phone IS NOT NULL\n    ORDER BY requested_at LIMIT 1 FOR UPDATE SKIP LOCKED)\n  RETURNING e.id, e.phone, e.reason\n)\nSELECT c.id, c.phone, c.reason,\n  coalesce((SELECT jsonb_agg(a.r2_key) FROM attachments a JOIN submissions s ON s.id = a.submission_id WHERE s.phone = c.phone), '[]'::jsonb) AS files,\n  coalesce((SELECT jsonb_agg(DISTINCT s.chatwoot_contact_id) FROM submissions s WHERE s.phone = c.phone AND s.chatwoot_contact_id IS NOT NULL), '[]'::jsonb) AS contacts\nFROM claimed c;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2004d6af-1a6c-52e9-a169-9e91ef0487d2",
          "name": "talent-pg"
        }
      },
      "executeOnce": true
    },
