        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE attachments\nSET transcript_status = CASE WHEN transcript_attempts >= 3 THEN 'failed' ELSE 'pending' END,\n    transcript_error = coalesce(transcript_error, 'Timed out waiting for Sarvam'),\n    updated_at = now()\nWHERE transcript_status = 'running' AND updated_at < now() - interval '20 minutes'\nRETURNING id;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2004d6af-1a6c-52e9-a169-9e91ef0487d2",
          "name": "talent-pg"
        }
      },
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "id": "82f1ef0b-0698-5e89-a3b2-cd7a97eee519",
      "name": "Claim voice notes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE attachments a\nSET transcript_status = 'running', transcript_attempts = a.transcript_attempts + 1,\n    transcript_error = NULL, updated_at = now()\nFROM submissions s\nWHERE s.id = a.submission_id\n  AND a.id IN (\n    SELECT id FROM attachments WHERE transcript_status = 'pending'\n    ORDER BY created_at LIMIT 3 FOR UPDATE SKIP LOCKED)\nRETURNING a.id, a.r2_key, a.mime, s.locale,\n  a.id || '.' || CASE split_part(a.mime, ';', 1)\n    WHEN 'audio/webm' THEN 'webm' WHEN 'audio/ogg' THEN 'ogg' WHEN 'audio/mpeg' THEN 'mp3'\n    WHEN 'audio/wav' THEN 'wav' WHEN 'audio/aac' THEN 'aac' ELSE 'm4a' END AS file_name;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "2004d6af-1a6c-52e9-a169-9e91ef0487d2",
          "name": "talent-pg"
        }
      },
