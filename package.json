{
  "name": "vayasyaseva-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit && pnpm windmill:check && pnpm twenty:check",
    "forms:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/job-resume.spec.mjs tests/job-intake.spec.mjs tests/registry.spec.mjs tests/crew-request.spec.mjs tests/lead-forward.spec.mjs tests/submissions.spec.mjs",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content-check.mjs",
    "content:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/sitemap-snapshot.spec.mjs tests/registry-status.spec.mjs tests/legacy-redirects.spec.mjs tests/wages.spec.mjs tests/wage-monitor.spec.mjs tests/language-rank.spec.mjs tests/context.spec.mjs tests/context-replay.spec.mjs tests/neutral-pages.spec.mjs tests/stored-ids.spec.mjs tests/markets.spec.mjs tests/measurement-policy.spec.mjs tests/contributions.spec.mjs",
    "wages:monitor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/wage-monitor/index.mjs",
    "forms:check": "node tests/forms.spec.mjs",
    "measurement:check": "node tests/measurement.spec.mjs",
    "windmill:check": "tsc -p integrations/windmill",
    "twenty:check": "tsc -p integrations/twenty",
    "windmill:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test integrations/windmill/*.test.mts",
    "windmill:build": "node integrations/windmill/build.mts",
    "windmill:deploy": "node integrations/windmill/deploy.mts",
    "talent:sync-secrets": "node scripts/sync-vercel-secrets.mts",
    "msg91:setup-contact-templates": "node scripts/setup-msg91-contact-templates.mjs",
    "openapi:generate": "pnpm contracts:generate && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-openapi.mjs",
    "openapi:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-openapi.mjs",
    "contracts:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON packages/contracts/scripts/generate.mjs",
    "contracts:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON packages/contracts/scripts/generate.mjs --check",
    "contracts:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test packages/contracts/test/*.test.mjs",
    "ai:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-ai-discovery.mjs",
    "lint:slop": "node scripts/slop-lint.mjs",
    "share:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-share-images.mjs",
    "share:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-share-images.mjs --check",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "context:replay": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/context-replay.mjs",
    "seo:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seo-check.mjs",
    "phone:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-jobs-phone.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "^16.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vspl/contracts": "workspace:*",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "^16.3.5",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.17.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "postgres": "3.4.7",
    "shadcn": "^4.3.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "windmill-client": "1.822.0"
  }
}
