  "$id": "https://www.vayasyaseva.com/contracts/envelope.v1.canonical.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "sentAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "idempotencyKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "job_application.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^VS-J-[A-Z0-9]{6}$"
        },
        "payload": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^VS-J-[A-Z0-9]{6}$"
            },
            "source": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "web"
                },
                {
                  "type": "string",
                  "const": "whatsapp"
                },
                {
                  "type": "string",
                  "enum": [
                    "web_en",
                    "web_hi",
                    "web_hinglish"
                  ]
                }
              ]
            },
            "locale": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "en-IN",
                    "hi-IN",
                    "hi-Latn-IN",
                    "pa-IN",
                    "kn-IN"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "cluster": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "haridwar",
                    "uttarakhand",
                    "delhi-ncr",
                    "bengaluru",
                    "jalandhar",
                    "saharanpur",
                    "other",
                    "punjab",
                    "dehradun",
                    "kapurthala",
                    "visakhapatnam",
                    "andhra-pradesh",
                    "hyderabad",
                    "telangana"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "pageCluster": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "haridwar",
                    "uttarakhand",
                    "delhi-ncr",
                    "bengaluru",
                    "jalandhar",
                    "saharanpur",
                    "other",
                    "punjab",
                    "dehradun",
                    "kapurthala",
                    "visakhapatnam",
                    "andhra-pradesh",
                    "hyderabad",
                    "telangana"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "pagePath": {
              "anyOf": [
