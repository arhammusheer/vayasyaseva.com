{
  "version": "1.3.0",
  "request": {
    "fields": {
      "name": {
        "type": "string",
        "required": true,
        "minLength": 2,
        "description": "Full name of the requester",
        "requiredMessage": "Name is required",
        "example": "Arham Musheer"
      },
      "company": {
        "type": "string",
        "required": false,
        "minLength": 1,
        "description": "Company name. The website form asks for it; agent requests should include it when the person gives it.",
        "requiredMessage": "Company name is required",
        "example": "Vayasya Seva Private Limited"
      },
      "role": {
        "type": "string",
        "required": false,
        "minLength": 1,
        "description": "Designation of the requester",
        "requiredMessage": "Your role is required",
        "example": "Warehouse Manager"
      },
      "phone": {
        "type": "string",
        "required": true,
        "minLength": 10,
        "description": "Phone number with country/area code",
        "requiredMessage": "Valid phone number is required",
        "example": "+91 98765 43210"
      },
      "email": {
        "type": "string",
        "required": false,
        "format": "email",
        "description": "Business email address",
        "formatMessage": "Valid email is required",
        "example": "ops@example.com"
      },
      "location": {
        "type": "string",
        "required": false,
        "minLength": 1,
        "description": "Deprecated since 1.2.0: use siteState and siteCity. Site location for service delivery",
        "requiredMessage": "Location is required",
        "example": "SIDCUL Haridwar",
        "deprecated": true
      },
      "industry": {
        "type": "string",
        "required": false,
        "minLength": 1,
        "description": "Deprecated since 1.2.0: put it in details. Industry classification",
        "requiredMessage": "Please select an industry",
        "example": "Manufacturing",
        "deprecated": true
      },
      "headcount": {
        "type": "string",
        "required": false,
        "minLength": 1,
        "description": "Deprecated since 1.2.0: use headcountBand. Approximate number of workers required",
        "requiredMessage": "Approximate headcount is required",
        "example": "50",
        "deprecated": true
      },
      "shiftRequirement": {
        "type": "string",
        "required": false,
        "description": "Deprecated since 1.2.0: use shiftPattern. Shift structure requirement",
        "example": "2 shifts, 8 hours each",
        "deprecated": true
      },
      "targetStartDate": {
        "type": "string",
        "required": false,
        "description": "Deprecated since 1.2.0: use startWindow. Preferred start date",
        "example": "2026-03-01",
        "deprecated": true
      },
      "roles": {
        "type": "enum-array",
        "required": false,
        "minItems": 1,
        "description": "The work the crew will do. One or more role ids.",
        "requiredMessage": "Choose at least one kind of work",
        "values": {
          "factory-helpers": "Factory helpers",
          "packing": "Packing",
          "machine-operators": "Machine operators",
          "loading-unloading": "Loading and unloading",
          "warehouse": "Warehouse picking and dispatch",
          "housekeeping": "Housekeeping (factory, office, campus)",
          "iti-trades": "ITI trades (electrician, fitter, welder)",
          "maintenance": "Maintenance technicians",
          "fabrication-civil": "Fabrication and civil crews",
          "gardening": "Gardening and grounds",
          "data-entry": "Data entry and stores",
          "forklift": "Forklift operators",
          "other": "Something else"
        },
        "example": [
          "packing",
          "loading-unloading"
        ]
      },
      "headcountBand": {
        "type": "enum",
        "required": false,
        "description": "How many workers are needed, as a band.",
        "requiredMessage": "Choose how many workers you need",
        "values": {
          "1-9": "1 to 9 workers",
          "10-19": "10 to 19 workers",
          "20-49": "20 to 49 workers",
          "50-99": "50 to 99 workers",
          "100-249": "100 to 249 workers",
          "250+": "250 or more workers"
        },
        "example": "50-99"
      },
      "siteState": {
        "type": "enum",
        "required": false,
        "description": "State or union territory of the site, as an ISO 3166-2:IN code.",
        "requiredMessage": "Choose the state the site is in",
        "values": {
          "AN": "Andaman and Nicobar Islands",
          "AP": "Andhra Pradesh",
          "AR": "Arunachal Pradesh",
          "AS": "Assam",
          "BR": "Bihar",
          "CH": "Chandigarh",
          "CG": "Chhattisgarh",
          "DH": "Dadra and Nagar Haveli and Daman and Diu",
          "DL": "Delhi",
          "GA": "Goa",
          "GJ": "Gujarat",
          "HR": "Haryana",
          "HP": "Himachal Pradesh",
          "JK": "Jammu and Kashmir",
          "JH": "Jharkhand",
          "KA": "Karnataka",
          "KL": "Kerala",
          "LA": "Ladakh",
          "LD": "Lakshadweep",
          "MP": "Madhya Pradesh",
          "MH": "Maharashtra",
          "MN": "Manipur",
          "ML": "Meghalaya",
          "MZ": "Mizoram",
          "NL": "Nagaland",
          "OD": "Odisha",
          "PY": "Puducherry",
          "PB": "Punjab",
          "RJ": "Rajasthan",
          "SK": "Sikkim",
          "TN": "Tamil Nadu",
          "TS": "Telangana",
          "TR": "Tripura",
          "UP": "Uttar Pradesh",
          "UK": "Uttarakhand",
          "WB": "West Bengal"
        },
        "example": "UK"
      },
      "siteCity": {
        "type": "string",
        "required": false,
        "minLength": 2,
        "maxLength": 120,
        "description": "City, town or industrial area of the site.",
        "requiredMessage": "Tell us the city or area",
        "example": "SIDCUL Haridwar"
      },
      "sitePincode": {
        "type": "string",
        "required": false,
        "pattern": "^[1-9][0-9]{5}$",
        "description": "Six-digit PIN code of the site.",
        "patternMessage": "A PIN code has 6 digits",
        "example": "249403"
      },
      "startWindow": {
        "type": "enum",
        "required": false,
        "description": "When the crew should start.",
        "requiredMessage": "Choose when work should start",
        "values": {
          "within-1-week": "Within a week",
          "2-4-weeks": "In 2 to 4 weeks",
          "1-3-months": "In 1 to 3 months",
          "planning": "Just planning"
        },
        "example": "2-4-weeks"
      },
      "durationBand": {
        "type": "enum",
        "required": false,
        "description": "How long the work is expected to last.",
        "requiredMessage": "Choose how long the work will last",
        "values": {
          "under-1-month": "Under a month",
          "1-3-months": "1 to 3 months",
          "3-12-months": "3 to 12 months",
          "ongoing": "Ongoing (no end date)",
          "not-sure": "Not sure yet"
        },
        "example": "ongoing"
      },
      "shiftPattern": {
        "type": "enum",
        "required": false,
        "description": "Shift pattern at the site. Every shift is 8 hours.",
        "values": {
          "general": "General (one day shift)",
          "two-shifts": "Two shifts",
          "three-shifts": "Three shifts (round the clock)",
          "night-only": "Night shift only",
          "not-sure": "Not sure yet"
        },
        "example": "two-shifts"
      },
      "requestType": {
        "type": "enum",
        "required": false,
        "description": "What the person is asking for: a crew (the default), a site assessment first, or help getting their own site compliant (EPF, ESIC, PT, LWF, contract labour licence, registers, minimum wage; send details and siteState).",
        "values": {
          "crew": "A crew",
          "site-assessment": "A site assessment",
          "compliance-help": "Compliance help"
        },
        "example": "crew"
      },
      "pageCluster": {
        "type": "string",
        "required": false,
        "maxLength": 32,
        "pattern": "^[a-z-]{2,32}$",
        "description": "Set by the website: the cluster of the page the form was opened from. Agents leave it out.",
        "example": "haridwar"
      },
      "sourcePath": {
        "type": "string",
        "required": false,
        "maxLength": 200,
        "pattern": "^/[A-Za-z0-9/_-]*$",
        "description": "Set by the website: the page the person came from. Agents leave it out.",
        "example": "/locations/haridwar"
      },
      "details": {
        "type": "string",
        "required": false,
        "description": "Anything else about the requirement: the work, the site, timings. Required when the structured requirement fields are left out.",
        "requiredMessage": "Tell us about the requirement",
        "example": "Need housekeeping teams, fabrication fitters, and preventive maintenance support for a new line.",
        "maxLength": 10000
      }
    },
    "requireOneOf": [
      [
        "details"
      ],
      [
        "roles",
        "headcountBand",
        "siteState",
        "siteCity",
        "startWindow",
        "durationBand"
      ]
    ],
    "requireOneOfMessage": "Send either details, or the requirement fields roles, headcountBand, siteState, siteCity, startWindow and durationBand."
  },
  "responses": {
    "successMessage": "Requirement received. Our team will review it and reply. We aim to reply within two working days (Monday to Saturday, IST).",
    "validationError": "Invalid form data.",
    "rateLimitError": "Too many submissions. Please try again shortly.",
    "verificationError": "We couldn't verify this browser. Please complete the check and try again, or call us.",
    "unknownError": "Something went wrong. Please try again or contact us directly."
  }
}
